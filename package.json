{
  "name": "@modusoperandi/licit-object-id",
  "version": "1.0.0",
  "type": "module",
  "subversion": "1",
  "description": "ObjectId plugin built with ProseMirror",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MO-Movia/licit-object-id"
  },
  "scripts": {
    "lint:ts": "eslint src --ext .ts --fix",
    "lint:css": "echo no CSS in this project",
    "lint": "npm run lint:css & npm run lint:ts",
    "test": "jest --coverage",
    "test:unit": "jest --coverage",
    "test:coverage": "jest --coverage",
    "debug": "node --debug-brk --inspect ./node_modules/.bin/jest -i",
    "ci:build": "tsc -b tsconfig.prod.json --clean && tsc -b tsconfig.prod.json && copyfiles --up 1 \"src/**/*.css\" dist  && copyfiles package.json README.md LICENSE dist",
    "ci:bom": "npx cyclonedx-npm --ignore-npm-errors --short-PURLs --output-format XML --output-file dist/bom.xml",
    "verify": "npm run lint -- --fix && npm run ci:build && npm run test:coverage && echo 'All Tests Passed!'"
  },
  "peerDependencies": {
    "@modusoperandi/licit-doc-attrs-step": "^1.0.0",
    "prosemirror-model": "^1.16.0",
    "prosemirror-state": "^1.0.0",
    "prosemirror-view": "^1.0.0",
    "prosemirror-utils": "^1.0.0"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@modusoperandi/licit-doc-attrs-step": "1.0.5",
    "@modusoperandi/eslint-config": "^2.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.37.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jest-prosemirror": "^3.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}